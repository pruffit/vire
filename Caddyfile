# Домены берутся из .env (DOMAIN, CDN_DOMAIN, ACME_EMAIL).
# Caddy сам выпускает и продлевает TLS Let's Encrypt. Перед Caddy стоит Cloudflare.
{
	email {$ACME_EMAIL}
	# Выключено вместе с encode ниже, когда вис стриминг Next 16; включать — только проверив стриминг.
	servers {
		protocols h1
	}
}

# www → без www
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Основной сайт → Next.js
{$DOMAIN} {
	# encode выключен: виснет на стриминге Next 16, сжатие делает Cloudflare.
	reverse_proxy web:3000
}

# CDN-сабдомен → публичный bucket MinIO (обложки + HLS-стрим).
# Приватный vault MinIO отдаёт здесь AccessDenied без подписи — безопасно.
{$CDN_DOMAIN} {
	encode gzip
	reverse_proxy minio:9000
}
