{
  "name": "@vire/web",
  "version": "1.54.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:routes": "node scripts/check-route-slugs.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:caller": "node scripts/check-caller.mjs",
    "prebuild": "node scripts/build-rnd.mjs && node scripts/check-route-slugs.mjs && node scripts/check-i18n.mjs && node scripts/check-contracts.mjs && node scripts/check-caller.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node ../../node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:design": "impeccable detect app components",
    "rnd": "node scripts/build-rnd.mjs",
    "rnd:watch": "node scripts/build-rnd.mjs --watch"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
