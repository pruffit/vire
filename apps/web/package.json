    "@dnd-kit/utilities": "^3.2.2",
    "@vire/api-client": "workspace:*",
    "@vire/api-contracts": "workspace:*",
    "@vire/core": "workspace:*",
    "@vire/db": "workspace:*",
    "@vire/i18n": "workspace:*",
    "@vire/storage": "workspace:*",
    "@vire/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "hls.js": "^1.6.16",
    "ioredis": "^6.0.0",
    "libsodium-wrappers": "0.7.15",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.1",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4",
    "zod": "^3.25.0",
    "zustand": "^5.0.14"
