{
  "extends": "@vire/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "drizzle-orm": ["../../packages/db/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../packages/db/node_modules/drizzle-orm/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
