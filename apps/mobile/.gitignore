# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase — секреты, не для git (см. docs/features/mobile-app.md, инкремент 17)
google-services.json
*-firebase-adminsdk-*.json
*.password.txt

# typescript
*.tsbuildinfo

# локальные сборки APK для sideload — не для git
*.apk

# Claude Design canvas — сид-пейлоад редактора (~2МБ), не исходник; исходники — *.dc.html
design/*.html
!design/*.dc.html

# generated native folders
/ios
/android

# Артефакты сборки локальных нативных модулей (modules/*/android/build)
modules/*/android/build/
modules/*/android/.cxx/

# Каталог нативной сборки, вынесенный из pnpm-стора (plugins/with-native-build-dir.js)
.cxx/

# Снимки стенда для scripts/glass-probe.mjs
.glass-shots
