# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vire:vire@localhost:5432/vire

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO локально / Selectel S3 на проде) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VAULT=vire-vault
S3_BUCKET_STREAM=vire-stream

# --- Auth ---
AUTH_SECRET=change-me-generate-a-long-random-string
AUTH_URL=http://localhost:3000

# Yandex OAuth (oauth.yandex.ru → Мои приложения → Создать)
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Google OAuth (console.cloud.google.com → Credentials → OAuth 2.0)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Telegram Login Widget (создай бота через @BotFather, потом /setdomain)
# TELEGRAM_BOT_TOKEN — секретный, только серверная сторона
TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_ — публичный: имя бота без @, отображается в виджете
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# S3 public endpoint — используется для публичных URL обложек и HLS
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Email (Brevo HTTP API) ---
# Получить: app.brevo.com → Settings → API Keys → Create a new API key
BREVO_API_KEY=
# От кого отправлять (домен должен быть верифицирован в Brevo → Senders & IP)
SMTP_FROM=Vire <noreply@viremusic.ru>
# Куда падает обратная связь с /feedback (по умолчанию — на SMTP_FROM)
FEEDBACK_TO=

# --- YooKassa (платёжный провайдер) ---
# Получить: yookassa.ru → Интеграция → HTTP API → shopId + secretKey
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- App ---
NODE_ENV=development
# Используется в ссылках внутри писем
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Аналитика ---
# Яндекс.Метрика: номер счётчика (metrika.yandex.ru → Счётчики → Код счётчика)
# Если не задан — скрипт не подключается
NEXT_PUBLIC_METRIKA_ID=

# --- Мониторинг / алерты ---
# Алерты об ошибках, упавших джобах и падении воркера. Можно включить любой/оба
# канала; пусто → только лог в stderr. Подробности: docs/features/monitoring.md
# Telegram: переиспользует TELEGRAM_BOT_TOKEN (см. выше) + ID чата для алертов.
# Чтобы узнать chat_id: написать боту, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять message.chat.id.
TELEGRAM_ALERT_CHAT_ID=
# Generic-webhook (POST JSON): вебхук Discord/Slack или любой консьюмер.
ALERT_WEBHOOK_URL=

# Sentry (детальные стектрейсы/группировка ошибок рядом с Telegram-алертами).
# Всё DSN-gated: пусто → Sentry полностью выключен (no-op), ничего не шлётся.
# DSN из проекта Sentry (Settings → Client Keys). Серверный и клиентский совпадают.
# SENTRY_DSN — сервер (роуты/RSC) + воркер; NEXT_PUBLIC_SENTRY_DSN — браузер (тот же DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Опц. для загрузки source maps (читаемые стектрейсы) — пока не настроено, см. monitoring.md.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
