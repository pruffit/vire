# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vire:vire@localhost:5432/vire

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO локально / Selectel S3 на проде) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VAULT=vire-vault
S3_BUCKET_STREAM=vire-stream

# --- Auth ---
AUTH_SECRET=change-me-generate-a-long-random-string
AUTH_URL=http://localhost:3000

# Yandex OAuth (oauth.yandex.ru → Мои приложения → Создать)
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Google OAuth (console.cloud.google.com → Credentials → OAuth 2.0)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# VK OAuth (vk.com/editapp → создать приложение → подключить Вход через VK)
AUTH_VK_ID=
AUTH_VK_SECRET=

# Telegram Login Widget (создай бота через @BotFather, потом /setdomain)
# TELEGRAM_BOT_TOKEN — секретный, только серверная сторона
TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_ — публичный: имя бота без @, отображается в виджете
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# S3 public endpoint — используется для публичных URL обложек и HLS
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Email (Resend) ---
# Получить ключ: resend.com → API Keys
RESEND_API_KEY=re_your_key_here
# От кого отправлять письма (домен должен быть верифицирован в Resend)
RESEND_FROM=Vire <noreply@vire.music>
# Куда падает обратная связь с /feedback (по умолчанию — на RESEND_FROM)
FEEDBACK_TO=

# --- YooKassa (платёжный провайдер) ---
# Получить: yookassa.ru → Интеграция → HTTP API → shopId + secretKey
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- App ---
NODE_ENV=development
# Используется в ссылках внутри писем
NEXT_PUBLIC_APP_URL=http://localhost:3000
VK_SERVICE_TOKEN=
