# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://vire:vire@localhost:5432/vire

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO локально / Selectel S3 на проде) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VAULT=vire-vault
S3_BUCKET_STREAM=vire-stream

# --- Auth ---
AUTH_SECRET=change-me-generate-a-long-random-string
AUTH_URL=http://localhost:3000

# Секрет для HMAC-подписи внутренних ссылок/id (sessionId присутствия, отписка
# от гостевых пресейвов). Опционально — если пусто, используется AUTH_SECRET
# (см. apps/web/lib/app-secret.ts). Задай отдельно, если хочешь ротировать
# независимо от Auth.js-секрета.
LINK_SIGNING_SECRET=

# Yandex OAuth (oauth.yandex.ru → Мои приложения → Создать)
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Google OAuth (console.cloud.google.com → Credentials → OAuth 2.0)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Telegram Login Widget (создай бота через @BotFather, потом /setdomain)
# TELEGRAM_BOT_TOKEN — секретный, только серверная сторона
TELEGRAM_BOT_TOKEN=
# NEXT_PUBLIC_ — публичный: имя бота без @, отображается в виджете
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# S3 public endpoint — используется для публичных URL обложек и HLS
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Email (Brevo HTTP API) ---
# Получить: app.brevo.com → Settings → API Keys → Create a new API key
BREVO_API_KEY=
# От кого отправлять (домен должен быть верифицирован в Brevo → Senders & IP)
SMTP_FROM=VireMusic <noreply@viremusic.ru>
# Куда падает обратная связь с /feedback (по умолчанию — на SMTP_FROM)
FEEDBACK_TO=

# --- Web-push (VAPID) ---
# Генерация: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@viremusic.ru
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- YooKassa (платёжный провайдер) ---
# Получить: yookassa.ru → Интеграция → HTTP API → shopId + secretKey
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- App ---
NODE_ENV=development
# Используется в ссылках внутри писем
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Аналитика ---
# Яндекс.Метрика: номер счётчика (metrika.yandex.ru → Счётчики → Код счётчика)
# Если не задан — скрипт не подключается
NEXT_PUBLIC_METRIKA_ID=

# --- Автоопределение жанра (Essentia discogs-effnet, apps/worker) ---
# По умолчанию выключено. Модель качается: pnpm --filter @vire/worker models:download
# Лицензия MTG на модель — CC BY-NC-ND 4.0 (некоммерческая), см. docs/features/auto-genre.md
AUTO_GENRE=false
# Куда скачана модель (models:download) — по умолчанию apps/worker/models
AUTO_GENRE_MODELS_DIR=

# --- Мониторинг / алерты ---
# Алерты об ошибках, упавших джобах и падении воркера. Можно включить любой/оба
# канала; пусто → только лог в stderr. Подробности: docs/features/monitoring.md
# Telegram: переиспользует TELEGRAM_BOT_TOKEN (см. выше) + ID чата для алертов.
# Чтобы узнать chat_id: написать боту, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять message.chat.id.
TELEGRAM_ALERT_CHAT_ID=
# Generic-webhook (POST JSON): вебхук Discord/Slack или любой консьюмер.
ALERT_WEBHOOK_URL=

# --- Вечеринка: резолв внешних треков (YouTube) ---
# console.cloud.google.com → APIs & Services → включить YouTube Data API v3 → Credentials.
# Опционально: без ключа прямые ссылки на YouTube/SoundCloud всё равно резолвятся (oEmbed,
# без ключа), но поиск чужого трека по тексту — нет. search.list стоит 100 юнитов из 10 000/сутки.
YOUTUBE_API_KEY=

# --- Вечеринка: предложка по вкусу (Last.fm) ---
# last.fm/api/account/create → ключ выдаётся мгновенно, серверный, в браузер не уходит.
# Опционально: без ключа блок «Из вашего вкуса» в /profile и на вечеринке просто не появляется.
LASTFM_API_KEY=
