# Зависимости и артефакты сборки — ставятся/собираются внутри образа
**/node_modules
**/.next
**/dist
**/.turbo

# VCS и локальное окружение
.git
.gitignore
**/.env
**/.env.*
!**/.env.example

# Локальная инфраструктура и доки
docker-compose.yml
**/*.md
**/.vscode
**/.idea

# Тесты и отчёты
**/coverage
**/*.test.ts
**/__tests__

# ONNX-модель автожанра качается RUN-слоем в apps/worker/Dockerfile —
# локальная копия не должна перетирать её через COPY . .
apps/worker/models
