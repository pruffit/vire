auto-install-peers=true
strict-peer-dependencies=false
# Windows MAX_PATH: пакеты с длинным name@version_peerHash в node_modules/.pnpm/ (например
# expo-modules-core) вместе с вложенными native-путями (android/.cxx/.../CMakeFiles/*.dir/)
# превышают лимит CMake в 250 символов на путь к объектному файлу — сборка apps/mobile для
# Android падает (ninja: manifest still dirty). Короче порог хеширования имени папки в
# .pnpm/ — НЕ трогает физическое расположение стора (остаётся внутри node_modules, которое
# уже входит в watchFolders Metro, apps/mobile/metro.config.js) в отличие от переноса
# virtual-store-dir на путь снаружи node_modules, который ломает hierarchical lookup Metro.
virtual-store-dir-max-length=20
