{
  "name": "vire",
  "version": "1.4.2",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "icons:build": "node scripts/build-icons.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "simple-icons": "^16.24.0",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "ffprobe-static"
    ],
    "overrides": {
      "postcss": ">=8.5.10",
      "esbuild": ">=0.28.1",
      "nodemailer": ">=9.0.1"
    }
  }
}
