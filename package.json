{
  "name": "vire",
  "version": "1.56.2",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "icons:build": "node scripts/build-icons.mjs",
    "check:doc-paths": "node scripts/check-doc-paths.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1"
  },
  "devDependencies": {
    "typescript-7": "npm:typescript@7.0.2",
    "turbo": "^2.11.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "ffprobe-static",
      "onnxruntime-node"
    ],
    "overrides": {
      "postcss": ">=8.5.18",
      "nanoid": "^3.3.17",
      "esbuild": ">=0.28.1",
      "nodemailer": "^10.0.6",
      "adm-zip": "^0.6.1",
      "sharp": "^0.35.5",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@auth/core": ">=0.41.3",
      "brace-expansion@<2": "^1.1.20",
      "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9",
      "js-yaml": ">=5.2.2",
      "shell-quote@<1.11.0": "^1.11.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "ip-address@<=10.3.0": ">=10.3.1",
      "browserslist": "^4.28.7",
      "decode-uri-component": "^0.5.0",
      "uuid@<11.1.1": "^11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg",
        "GHSA-4cwx-7wf7-3272"
      ],
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2"
  }
}
