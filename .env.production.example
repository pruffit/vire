# ─────────────────────────────────────────────────────────────
# ПРОД. Скопируй в .env на сервере и заполни. НЕ коммить .env.
# Хосты — это имена сервисов из docker-compose.prod.yml.
# ─────────────────────────────────────────────────────────────

# --- Домены (для Caddy + Auth) ---
DOMAIN=vire.example.ru
CDN_DOMAIN=cdn.vire.example.ru
ACME_EMAIL=admin@vire.example.ru

# --- PostgreSQL (контейнер postgres) ---
POSTGRES_USER=vire
POSTGRES_PASSWORD=ЗАМЕНИ_НА_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=vire
DATABASE_URL=postgresql://vire:ЗАМЕНИ_НА_ДЛИННЫЙ_ПАРОЛЬ@postgres:5432/vire

# --- Redis (контейнер redis) ---
REDIS_URL=redis://redis:6379

# --- Object Storage (контейнер minio) ---
# S3_ENDPOINT — внутренний, для SDK (web/worker ↔ minio).
S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT — публичные URL обложек и HLS (через Caddy cdn-сабдомен).
S3_PUBLIC_ENDPOINT=https://cdn.vire.example.ru
S3_REGION=ru-1
S3_ACCESS_KEY=vire-minio
S3_SECRET_KEY=ЗАМЕНИ_НА_ДЛИННЫЙ_СЕКРЕТ
S3_BUCKET_VAULT=vire-vault
S3_BUCKET_STREAM=vire-stream

# --- Auth ---
AUTH_SECRET=СГЕНЕРИРУЙ: openssl rand -base64 32
AUTH_URL=https://vire.example.ru
NEXT_PUBLIC_APP_URL=https://vire.example.ru

# Yandex OAuth
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Telegram Login Widget
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Vire <noreply@vire.example.ru>
FEEDBACK_TO=

# --- YooKassa (Этап 2 — пока можно пусто) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

NODE_ENV=production

# ─────────────────────────────────────────────────────────────
# Бэкап-вынос (scripts/backup.sh) — внешний дешёвый S3
# ─────────────────────────────────────────────────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
