# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
.turbo/

# env & secrets
.env
.env.*
!.env.example
!.env.production.example

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# misc
*.local
coverage/
.ui-audit/

# Модели автоопределения жанра (Essentia discogs-effnet, ~18МБ) — скачиваются
# `pnpm --filter @vire/worker models:download`, не в git.
apps/worker/models/

# Локальный симлинк скилл-менеджера (абсолютный путь, не портабелен)
.claude/skills/make-interfaces-feel-better

# Изолированные рабочие копии сабагентов (git worktree) — эфемерны, не в git
.claude/worktrees/

# Личные permission-оверрайды (напр. доступ к конкретному прод-хосту) — не для команды
.claude/settings.local.json

# Ключи сервисных аккаунтов Firebase — секреты, никогда не в git
*-firebase-adminsdk-*.json

# Сборки Android: артефакты, а не исходники (по 90–180 МБ каждая)
*.apk
*.apk.idsig
*.aab
