# GlitchTip self-host — скопируй в .env рядом с docker-compose.yml и заполни.

# Случайные секреты:
#   SECRET_KEY:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 16
SECRET_KEY=
POSTGRES_PASSWORD=

# Внешний URL инстанса (за Caddy). Должен совпадать с доменом, по которому открываешь UI.
GLITCHTIP_DOMAIN=https://glitchtip.viremusic.ru

# От кого письма (нотификации/инвайты). С consolemail реально не отправляются — в лог.
DEFAULT_FROM_EMAIL=alerts@viremusic.ru

# Включи "true" ТОЛЬКО на время регистрации первого аккаунта, потом верни "false" и перезапусти.
ENABLE_OPEN_USER_REGISTRATION=false
